# Generated from config/environment-registry.json; do not edit by hand.
# These are deployment inputs only. Translator and per-title settings belong in product configuration.

# required | Envelope master key for durable field data.
# Why environmental: Secret held by the operator.
ITOTORI_FIELD_CIPHER_KEY=

# required | Single mounted root containing the corpus tree and read-only vault.
# Why environmental: Deployment mount point owned by the operator.
ITOTORI_VAULT_ROOT=

# optional; default: platform-specific cache directory | Writable root for transient extraction artifacts.
# Why environmental: Deployment storage location owned by the operator.
ITOTORI_SCRATCH_ROOT=

# optional; default: none | Key for BGI encrypted containers.
# Why environmental: Secret held by the operator.
KAIFUU_BGI_CONTAINER_KEY=

# optional; default: none | Key for encrypted Siglus archives.
# Why environmental: Secret held by the operator.
KAIFUU_SIGLUS_KEY=

# optional; default: none | Secondary key for encrypted Siglus archives.
# Why environmental: Secret held by the operator.
KAIFUU_SIGLUS_SECONDARY_KEY=

# optional; default: none | Key for encrypted RPG Maker assets.
# Why environmental: Secret held by the operator.
KAIFUU_RPG_MAKER_ASSET_KEY=

# optional; default: none | Secret for protected Utsushi runtime inputs.
# Why environmental: Secret held by the operator.
UTSUSHI_SECRET=
