{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpus"],
  "properties": {
    "schema": { "const": "inventory/v1" },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "engine", "variant", "root", "content_address", "tags", "access"],
        "properties": {
          "id": { "type": "string", "pattern": "^corpus-[a-z0-9-]+$" },
          "engine": { "type": "string", "pattern": "^engine-[a-z0-9-]+$" },
          "variant": { "type": "string", "pattern": "^variant-[a-z0-9-]+$" },
          "root": { "type": "string", "pattern": "^/" },
          "content_address": { "type": "string", "pattern": "^sha256:.+" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "access": { "const": "read-only" }
        }
      }
    }
  }
}
