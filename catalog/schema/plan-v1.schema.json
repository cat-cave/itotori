{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "lane", "requirements", "proofs"],
  "properties": {
    "schema": { "const": "plan/v1" },
    "id": { "type": "string", "pattern": "^plan-[a-z0-9-]+$" },
    "lane": { "type": "string", "pattern": "^lane-[a-z0-9-]+$" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^requirement-[a-z0-9-]+$" },
          "state": { "enum": ["satisfied", "absent"] },
          "diagnostic": { "type": "string" }
        }
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "engine", "corpora", "executor"],
        "properties": {
          "id": { "type": "string", "pattern": "^proof-[a-z0-9-]+$" },
          "engine": { "type": "string", "pattern": "^engine-[a-z0-9-]+$" },
          "corpora": {
            "type": "array",
            "items": { "type": "string", "pattern": "^corpus-[a-z0-9-]+$" }
          },
          "executor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "command", "selector"],
            "properties": {
              "kind": { "type": "string" },
              "command": { "type": "string" },
              "selector": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
