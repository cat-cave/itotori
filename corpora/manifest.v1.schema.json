{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cat-cave/itotori/corpora/manifest.v1.schema.json",
  "title": "Private Corpus Registry Manifest",
  "type": "object",
  "required": ["version", "corpora"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["engine", "ordinal", "variant", "path"],
        "additionalProperties": false,
        "properties": {
          "engine": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "variant": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        }
      }
    }
  }
}
