{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cat-cave/itotori/corpora/manifest.v1.schema.json",
  "title": "Private Corpus Registry Manifest",
  "type": "object",
  "required": ["version", "corpora"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "corpora": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*/[1-9][0-9]*/[a-z][a-z0-9-]*$"
      },
      "patternProperties": {
        "^[a-z][a-z0-9-]*/[1-9][0-9]*/[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
