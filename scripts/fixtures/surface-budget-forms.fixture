# Rust std::env::var / var_os / option_env! / env!
std::env::var("ITOTORI_PRODUCT_VERSION");
option_env!("UTSUSHI_BROWSER_BIN");
env!("ITOTORI_TARGET_LOCALE");

# TypeScript and JavaScript dot and bracket reads
process.env.ITOTORI_PRODUCT_VERSION;

# just export, default, and env_var call
export UTSUSHI_BROWSER_BIN := env_var_or_default('UTSUSHI_BROWSER_BIN', '')
locale := env_var_or_default('ITOTORI_TARGET_LOCALE', 'en')

# CI env block and expression
env:
  ITOTORI_PRODUCT_VERSION: fixture

# shell, Nix, Dockerfile, .env.example, and documentation
UTSUSHI_BROWSER_BIN=fixture-command
ITOTORI_TARGET_LOCALE = "en";
ITOTORI_PRODUCT_VERSION=fixture
Run with ITOTORI_PRODUCT_VERSION=fixture.
